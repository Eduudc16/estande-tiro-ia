# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O .env NAO vai para o GitHub: ele esta no .gitignore.

# Chave GRATUITA do Gemini (Google AI Studio): usada so para TEXTO, via Spring AI (ChatClient)
GEMINI_API_KEY_TEXT=

# Chave FATURADA do Gemini: usada EXCLUSIVAMENTE para gerar IMAGENS (modelo Nano Banana 2 Lite)
GEMINI_API_KEY_IMAGE=

# Maximo de imagens geradas por execucao do sistema (vazio = 5)
MAX_IMAGE_GENERATIONS=
